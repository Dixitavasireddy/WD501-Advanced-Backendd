<ul class="todo-list">

    <% if (todos.length === 0) { %>

        <li class="empty-todo">
            No todos in this category.
        </li>

    <% } %>


    <% todos.forEach((todo) => { %>

        <li class="todo-item">

            <div class="todo-content">

                <!-- Checkbox -->
                <input
                    type="checkbox"
                    id="todo-<%= todo.id %>"
                    class="todo-checkbox"
                    <%= todo.completed ? 'checked' : '' %>
                >

                <!-- Todo Title -->
                <label
                    for="todo-<%= todo.id %>"
                    class="todo-label <%= todo.completed ? 'completed' : '' %>"
                >
                    <%= todo.title %>
                </label>

            </div>


            <!-- Delete Button -->
            <button
                type="button"
                class="delete-button"
                data-id="<%= todo.id %>"
                title="Delete todo"
                aria-label="Delete <%= todo.title %>"
            >

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                >

                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 7h12M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2m2 0v12a2 2 0 01-2 2H9a2 2 0 01-2-2V7m3 4v6m4-6v6"
                    />

                </svg>

            </button>

        </li>

    <% }); %>

</ul>